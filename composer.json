{
    "name": "rockbuzz/lara-comments",
    "description": "Comments is a package for managing comments on features like Posts",
    "version": "9.0.0",
    "keywords": [
        "laravel",
        "comments",
        "like"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "TiagoDevWeb",
            "email": "tiago@rockbuzz.com.br"
        },
        {
            "name": "Paulo Henrique P. Scheuermann",
            "email": "paulo@rockbuzz.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "Rockbuzz\\LaraComments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rockbuzz\\LaraComments\\Tests\\": "tests/",
            "Rockbuzz\\LaraComments\\Database\\Factories\\": "database/factories/"
        }
    },
    "require": {
        "php": ">=8.1",
        "bensampo/laravel-enum": "^6.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.0",
        "orchestra/testbench": "^7.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "cs": "vendor/bin/phpcs"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rockbuzz\\LaraComments\\ServiceProvider"
            ]
        }
    }
}